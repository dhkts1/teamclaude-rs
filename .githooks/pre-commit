#!/usr/bin/env bash
# Pre-commit secret scan: block any commit that would introduce a secret.
# Scans ONLY the staged changes with gitleaks + .gitleaks.toml.
#
# Enable in a fresh clone:  git config core.hooksPath .githooks
set -euo pipefail

# Reminder (non-blocking): this repository is PUBLIC. The gitleaks scan below is
# the hard gate; this banner is the human nudge that everything committed here is
# world-readable once pushed.
printf '%s\n' \
  "──────────────────────────────────────────────────────────────" \
  "  ⚠  PUBLIC REPO — github.com/dhkts1/teamclaude-rs" \
  "  Anything you push is world-readable. Do NOT commit: secrets," \
  "  tokens, real account emails/UUIDs, ~/ paths, or internal" \
  "  (Henry) scaffolding — plans, bridges, swarm state." \
  "──────────────────────────────────────────────────────────────" >&2

# ── Secret scan (gitleaks) ──────────────────────────────────────────────────
# git runs hooks from the repo root, so cwd already holds .gitleaks.toml.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --no-banner --redact; then
    echo "" >&2
    echo "pre-commit: BLOCKED — gitleaks found a secret in your staged changes." >&2
    echo "  Remove it, or (if it's a genuine false positive) allowlist it in .gitleaks.toml." >&2
    exit 1
  fi
else
  # Warn only — a missing tool must not block every commit. Do NOT exit here,
  # or the rustfmt gate below becomes dead code on gitleaks-less machines.
  echo "pre-commit: gitleaks not installed — skipping secret scan (brew install gitleaks)." >&2
fi

# ── Rust format gate ────────────────────────────────────────────────────────
# Mirror CI's `cargo fmt --check` Format job so a formatting slip is caught here,
# not after a push goes red. Only fires when the commit stages Rust files.
if git diff --cached --name-only --diff-filter=ACM | grep -q '\.rs$'; then
  if command -v cargo >/dev/null 2>&1; then
    if ! cargo fmt --check >/dev/null 2>&1; then
      echo "" >&2
      echo "pre-commit: BLOCKED — cargo fmt --check failed; CI's Format job would go red." >&2
      echo "  Fix it:  cargo fmt   then re-stage and commit." >&2
      exit 1
    fi
  else
    echo "pre-commit: cargo not found — skipping rustfmt check." >&2
  fi
fi
