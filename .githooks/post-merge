#!/usr/bin/env bash
# Post-merge rebuild: keep the on-disk release binary tracking the checkout.
#
# Enable in a fresh clone:  git config core.hooksPath .githooks
#
# Why: the binary carries its commit sha (build.rs → TCR_BUILD_SHA), and a merge
# moves HEAD, so without this the artifact on disk claims a sha the checkout has
# already left behind. Rebuilding here means only ONE thing can be stale
# afterwards — the running process — which is exactly what `tcr status` reports.
#
# What this hook must NEVER do: restart, kill or signal a running tcr. A restart
# wipes the in-memory session→account pin map and cold-starts every live Claude
# Code session's prompt prefix — the most expensive event in this system, and a
# human's explicit choice at a quiet moment. This hook only replaces bytes on
# disk and says so.
set -euo pipefail

git_dir=$(git rev-parse --git-dir 2>/dev/null) || exit 0

# ── Do not build mid-operation ──────────────────────────────────────────────
# A rebase/cherry-pick tree is a snapshot of someone's in-flight work, not a
# commit anyone asked to build. These markers can genuinely be set while this
# hook runs — a rebase replaying a merge commit, a cherry-picked merge.
#
# MERGE_HEAD is deliberately NOT in this list, and must not be added back.
# Measured: git clears MERGE_HEAD *after* post-merge returns, not before, so on
# a plain `git merge --no-ff` the marker is present for the entire hook run and
# is gone the moment the merge completes. Testing for it here tests for the
# normal path, which skipped every rebuild the hook exists to do; only a
# fast-forward `git pull` ever got through — the case that needs it least.
# Nothing is lost by dropping it: `git merge` runs this hook only on success, so
# an unfinished or conflicted merge never reaches this code at all, and the
# unresolved-conflict check below covers the index either way.
for marker in CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
  if [ -e "$git_dir/$marker" ]; then
    echo "post-merge: $marker present — skipping the rebuild until the tree settles." >&2
    exit 0
  fi
done

# Unresolved conflict markers in the index. Belt and braces alongside the above.
if [ -n "$(git diff --name-only --diff-filter=U)" ]; then
  echo "post-merge: unresolved conflicts — skipping the rebuild." >&2
  exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
  # Warn only. A missing toolchain must never make a merge look like it failed.
  echo "post-merge: cargo not found — skipping the release rebuild." >&2
  exit 0
fi

# No filter on which paths the merge touched: HEAD moved, so TCR_BUILD_SHA
# changed, so the binary is stale even for a docs-only merge. Gating on *.rs
# would leave an artifact stamped with the wrong commit.
sha=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)
echo "post-merge: rebuilding tcr (release) at $sha — this takes a moment." >&2

# Quiet on success, loud on failure: cargo's output is captured and only replayed
# when the build fails.
# WHERE the build lands is not `target/` by assumption.
#
# `CARGO_TARGET_DIR` (or `build.target-dir` in a config.toml) redirects it
# elsewhere, and every agent session in this repo sets that variable. Measured
# 2026-08-06: this hook announced "built 2dc3138" while the binary went to
# ~/.cache/cargo-target and the repo's own target/release/tcr — the path the
# operator's `tcr` resolves through — stayed on the PREVIOUS sha. The hook
# reported success for work that landed somewhere the reader was not looking,
# which is the exact failure this hook exists to prevent, aimed at itself.
#
# `cargo metadata` is authoritative (it honours the env var AND config.toml).
# The `${CARGO_TARGET_DIR:-...}` fallback covers a machine without `jq` and is
# cargo's own rule minus the config-file case.
repo_root=$(git rev-parse --show-toplevel 2>/dev/null || echo .)
target_dir=""
if command -v jq >/dev/null 2>&1; then
  target_dir=$(cargo metadata --no-deps --format-version 1 2>/dev/null | jq -r '.target_directory // empty' || true)
fi
[ -n "$target_dir" ] || target_dir="${CARGO_TARGET_DIR:-$repo_root/target}"
bin="$target_dir/release/tcr"

log=$(mktemp -t tcr-post-merge)
if cargo build --release >"$log" 2>&1; then
  rm -f "$log"
  # Replacing the release binary does NOT disturb a running server: on Unix the
  # live process holds its own open inode, and cargo writes a NEW file over the
  # path. The old process keeps executing the old bytes until someone restarts
  # it — deliberately, per the note above. Do not "fix" this by signalling it.
  #
  # Verify rather than assert. "built $sha" was previously a claim; build.rs
  # stamps TCR_BUILD_SHA into the binary, so it costs one grep to make it a fact.
  if [ -f "$bin" ] && grep -aq "$sha" "$bin" 2>/dev/null; then
    echo "post-merge: built $sha -> $bin — a RUNNING tcr still serves the old binary; restart it when convenient." >&2

    # Build it AND put it on PATH. Building alone was the drift source: every
    # pull produced a fresh binary in the target dir while `~/.local/bin/tcr`
    # kept whatever it had, so `tcr` on PATH silently fell further behind HEAD
    # with each merge and the operator had no signal until something misbehaved.
    #
    # Safe against the class this repo cares about: install-cli.sh stages into
    # the destination's own directory and finishes with rename(2), so a running
    # `tcr` keeps its own inode and only the NEXT invocation picks up new code.
    # That is the same reasoning as the note above about cargo and the server —
    # replacing a path never disturbs a process already executing it. An
    # in-place `cp` here would instead SIGKILL every subsequent exec with
    # "Code Signature Invalid"; that is why this calls the script rather than
    # copying, and why it must keep calling the script.
    #
    # The script re-verifies the sha itself and refuses a symlinked or directory
    # destination, so a deliberate arrangement (e.g. ~/.local/bin/tcr pointed
    # into TcrBar.app) is reported and left alone rather than silently clobbered.
    #
    # Never fails the hook: the merge has already happened, and a post-merge
    # non-zero exit helps nobody. A refusal is printed, not swallowed.
    if [ -x "$repo_root/scripts/install-cli.sh" ]; then
      if install_out=$("$repo_root/scripts/install-cli.sh" 2>&1); then
        echo "post-merge: installed $sha onto PATH." >&2
      else
        echo "post-merge: PATH install declined or failed — \`tcr\` on PATH is NOT $sha:" >&2
        printf '%s\n' "$install_out" | sed 's/^/  /' >&2
      fi
    fi
  else
    echo "post-merge: built at $sha but $bin does not carry that sha — treat the on-disk binary as UNTRUSTED." >&2
  fi
  # Say it plainly when the artifact is not where a reader would look for it.
  if [ "$target_dir" != "$repo_root/target" ]; then
    echo "post-merge: NOTE — CARGO_TARGET_DIR is in effect, so $repo_root/target/release/tcr was NOT updated." >&2
  fi
else
  echo "" >&2
  echo "post-merge: BUILD FAILED at $sha — $bin is now STALE or missing." >&2
  echo "  The merge itself completed; only the rebuild failed. Full output:" >&2
  cat "$log" >&2
  rm -f "$log"
fi

# Always succeed: git ignores this hook's exit status, and a non-zero here would
# only mislead anyone reading it.
exit 0
